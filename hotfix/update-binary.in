#!/sbin/sh
#
# Lunaris Updater @VERSION_NAME@ for peridot builds that predate it.
#
#  1. Replaces /system_ext/priv-app/Updater/Updater.apk with Updater @VERSION_NAME@, signed with
#     the platform key of the installed build: the AOSP test key (builds up to 2026-09-05) or
#     the Lunaris release key (later builds).
#  2. On builds signed with the AOSP test keys, adds the current Lunaris release certificate to
#     /system/etc/security/otacerts.zip, next to the test key, so update_engine and
#     RecoverySystem accept OTAs signed with either key.
#
# Nothing is written until every check passes, and the original files are restored if a write
# fails. Generated by make-hotfix-zip.sh, which fills in the @...@ values.

OUTFD=$2
ZIPFILE=$3

VERSION_NAME="@VERSION_NAME@"
APK_TESTKEY_SHA256="@APK_TESTKEY_SHA256@"
APK_RELEASE_SHA256="@APK_RELEASE_SHA256@"
OTACERTS_SHA256="@OTACERTS_SHA256@"
# testkey.x509.pem, the only certificate the old builds trust for OTAs
TESTKEY_PEM_SHA256="@TESTKEY_PEM_SHA256@"
# DER of the platform certificates, as they appear in plat_mac_permissions.xml
TESTKEY_PLATFORM_HEX="@TESTKEY_PLATFORM_HEX@"
RELEASE_PLATFORM_HEX="@RELEASE_PLATFORM_HEX@"
# Builds from this time on already ship this Updater (or a newer one)
FIX_BUILD_UTC=@FIX_BUILD_UTC@
# Part of the OTA feed URL in the Lunaris peridot Updater's resources
OTA_FEED="Inventor365/evolution-peridot"

# The package parser cache only trusts entries newer than the package, and the recovery clock
# often starts in 1970, so date the new package after any cache entry a device can have
PACKAGE_MTIME=203001010000

# Only set by the host-side test harness, to run against images mounted elsewhere
R=${LUNARIS_HOTFIX_TEST_ROOT:-}

TMP=$R/tmp/lunaris_updater_hotfix
SE_MNT=$TMP/system_ext
SYS_MNT=$TMP/system
MD_MNT=$TMP/metadata
BACKUP=$TMP/backup

WRITTEN=""

ui_print() {
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    printf 'ui_print %s\nui_print\n' "$1" >> "/proc/self/fd/$OUTFD"
  else
    echo "$1"
  fi
}

set_progress() {
  [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ] && \
    printf 'set_progress %s\n' "$1" >> "/proc/self/fd/$OUTFD"
}

sha256() {
  sha256sum "$1" 2>/dev/null | cut -d' ' -f1
}

# The partitions are mounted inside $TMP: only remove it once nothing is mounted there, so rm
# can never descend into a partition
cleanup() {
  local mnt
  sync
  for mnt in $(grep " $TMP/" "$R/proc/mounts" | cut -d' ' -f2); do
    umount "$mnt" 2>/dev/null || umount -l "$mnt" 2>/dev/null
  done
  if grep -q " $TMP/" "$R/proc/mounts"; then
    rm -rf "$TMP/payload" "$BACKUP"
  else
    rm -rf "$TMP"
  fi
}

abort() {
  ui_print "! $1"
  [ -n "$2" ] && ui_print "! $2"
  ui_print "! Nothing was changed."
  cleanup
  exit 1
}

# Undoes the writes made so far, then aborts
rollback() {
  local f restored=1
  ui_print "! $1"
  for f in $WRITTEN; do
    case "$f" in
      apk) write_in_place "$BACKUP/Updater.apk" "$APK" "$APK_ORIG_SHA256" || restored=0 ;;
      otacerts) write_in_place "$BACKUP/otacerts.zip" "$OTACERTS" "$OTACERTS_ORIG_SHA256" || restored=0 ;;
    esac
  done
  if [ $restored -eq 1 ]; then
    ui_print "! The original files were restored."
  else
    ui_print "! Restoring the original files failed. Android will still"
    ui_print "! boot; reflash the full ROM to restore system updates."
  fi
  cleanup
  exit 1
}

# Whether the partition mounted at $3 has the blocks $1 needs beyond those $2 already has (the
# images are sparse, so holes count), plus a margin for extent tree blocks
has_room() {
  local bs need
  bs=$(stat -f -c %S "$3")
  need=$((($(stat -c %s "$1") + bs - 1) / bs - $(stat -c %b "$2") * $(stat -c %B "$2") / bs + 16))
  [ "$(stat -f -c %f "$3")" -ge $need ]
}

# The images are built nearly full, and ext4 keeps 2% of a partition (up to 16 MiB) in reserve
# that regular writes can't allocate from, so every write needing a block would fail. Lift the
# reserve on the partition being written; the kernel computes it again on the next mount.
lift_reserve() {
  local knob
  knob=$R/sys/fs/ext4/$(basename "$(readlink -f "$1")")/reserved_clusters
  [ -w "$knob" ] && echo 0 > "$knob" 2>/dev/null
}

# Overwrites $2 with $1 in place, verifies it against $3, then trims the tail. Until the trim,
# the old contents still fit in the file's blocks, so a failed write can be undone.
write_in_place() {
  local size
  size=$(stat -c %s "$1")
  dd if="$1" of="$2" bs=65536 conv=notrunc 2>/dev/null || return 1
  sync
  [ "$(head -c "$size" "$2" | sha256sum | cut -d' ' -f1)" = "$3" ] || return 1
  if [ "$(stat -c %s "$2")" -gt "$size" ]; then
    truncate -s "$size" "$2" || return 1
    sync
  fi
  [ "$(sha256 "$2")" = "$3" ]
}

slot_suffix() {
  local slot
  slot=$(getprop ro.boot.slot_suffix 2>/dev/null)
  if [ -z "$slot" ] && [ -r "$R/proc/bootconfig" ]; then
    slot=$(grep '^androidboot.slot_suffix' "$R/proc/bootconfig" | cut -d'"' -f2)
  fi
  if [ -z "$slot" ] && [ -r "$R/proc/cmdline" ]; then
    slot=$(tr ' ' '\n' < "$R/proc/cmdline" | grep '^androidboot.slot_suffix=' | cut -d= -f2)
  fi
  echo "$slot"
}

by_name() {
  if [ -e "$R/dev/block/by-name/$1" ]; then
    echo "$R/dev/block/by-name/$1"
  elif [ -e "$R/dev/block/bootdevice/by-name/$1" ]; then
    echo "$R/dev/block/bootdevice/by-name/$1"
  fi
}

# Recovery maps the logical partitions just before running this script; give udev a moment
mapper_dev() {
  local i=0
  while [ $i -lt 10 ]; do
    if [ -e "$R/dev/block/mapper/$1" ]; then
      echo "$R/dev/block/mapper/$1"
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

# Unmounts a partition recovery (or the user) already mounted, so it can be mounted here
release_dev() {
  local real mnt
  real=$(readlink -f "$1")
  for mnt in $(grep -E "^($1|$real) " "$R/proc/mounts" | cut -d' ' -f2); do
    umount "$mnt" 2>/dev/null || return 1
  done
}

mount_ro() {
  mkdir -p "$2"
  release_dev "$1" || return 1
  mount -t ext4 -o ro "$1" "$2" 2>/dev/null
}

remount_rw() {
  blockdev --setrw "$1" 2>/dev/null
  mount -o remount,rw "$2" 2>/dev/null || return 1
  grep -qE " $2 ext4 rw[, ]" "$R/proc/mounts"
}

selinux_label() {
  getfattr -n security.selinux "$1" 2>/dev/null | grep '^security.selinux=' | cut -d'"' -f2
}

# A virtual A/B update that is applied but not booted, or still merging, depends on the
# current partitions; writing to them could corrupt it
pending_update() {
  local md
  if ls "$R/dev/block/mapper" 2>/dev/null | grep -qE -- '-(cow|base|src)'; then
    return 0
  fi
  if grep -q " $R/metadata " "$R/proc/mounts"; then
    md=$R/metadata
  else
    local dev
    dev=$(by_name metadata)
    [ -n "$dev" ] || return 2
    mkdir -p "$MD_MNT"
    mount -t f2fs -o ro "$dev" "$MD_MNT" 2>/dev/null || \
      mount -t f2fs -o ro,norecovery "$dev" "$MD_MNT" 2>/dev/null || \
      mount -t ext4 -o ro "$dev" "$MD_MNT" 2>/dev/null || return 2
    md=$MD_MNT
  fi
  [ -n "$(ls -A "$md/ota/snapshots" 2>/dev/null)" ]
}

ui_print "*********************************************"
ui_print "  Lunaris Updater $VERSION_NAME for peridot"
ui_print "*********************************************"

if [ "$(getprop sys.boot_completed 2>/dev/null)" = "1" ]; then
  abort "Flash this zip from recovery, not from a running system."
fi

DEVICE=$(getprop ro.lunaris.device 2>/dev/null)
[ -n "$DEVICE" ] || DEVICE=$(getprop ro.lineage.device 2>/dev/null)
[ -n "$DEVICE" ] || DEVICE=$(getprop ro.product.device 2>/dev/null)
[ "$DEVICE" = "peridot" ] || abort "This zip is only for the POCO F6 (peridot), not '$DEVICE'."

SLOT=$(slot_suffix)
case "$SLOT" in
  _a|_b) ;;
  *) abort "Could not determine the active slot." ;;
esac
ui_print "- Active slot: $SLOT"

cleanup
if grep -q " $TMP/" "$R/proc/mounts"; then
  abort "A partition is still mounted under $TMP. Reboot recovery and try again."
fi
mkdir -p "$TMP" "$BACKUP"

ui_print "- Extracting files"
unzip -o -q -d "$TMP" "$ZIPFILE" 'payload/*' 2>/dev/null
NEW_OTACERTS=$TMP/payload/otacerts.zip
[ "$(sha256 "$TMP/payload/Updater-testkey.apk")" = "$APK_TESTKEY_SHA256" ] && \
  [ "$(sha256 "$TMP/payload/Updater-release.apk")" = "$APK_RELEASE_SHA256" ] && \
  [ "$(sha256 "$NEW_OTACERTS")" = "$OTACERTS_SHA256" ] || \
  abort "The zip is damaged. Download it again."
set_progress 0.1

# With verification enabled in vbmeta, dm-verity would reject the modified partitions and the
# device would not boot. Lunaris ships vbmeta with --flags 3 (verification disabled).
VBMETA=$(by_name "vbmeta$SLOT")
[ -n "$VBMETA" ] || abort "vbmeta$SLOT not found."
[ "$(head -c 4 "$VBMETA" 2>/dev/null)" = "AVB0" ] || abort "vbmeta$SLOT is not a valid vbmeta image."
VBMETA_FLAGS=$(od -An -tu1 -j123 -N1 "$VBMETA" 2>/dev/null | tr -d ' \n')
if [ -z "$VBMETA_FLAGS" ] || [ $((VBMETA_FLAGS & 3)) -eq 0 ]; then
  abort "dm-verity is enabled on this device (vbmeta flags $VBMETA_FLAGS)." \
        "Modifying system would make it unbootable."
fi

pending_update
case $? in
  0) abort "An update is installed but not booted yet, or is still being merged." \
           "Boot into Android, wait ~10 minutes, then flash this again." ;;
  2) abort "Could not read /metadata to check for a pending update." ;;
esac

ui_print "- Mounting system and system_ext"
SE_DEV=$(mapper_dev "system_ext$SLOT") || abort "system_ext$SLOT is not mapped."
SYS_DEV=$(mapper_dev "system$SLOT") || abort "system$SLOT is not mapped."
mount_ro "$SE_DEV" "$SE_MNT" || abort "Could not mount system_ext$SLOT."
mount_ro "$SYS_DEV" "$SYS_MNT" || abort "Could not mount system$SLOT."
set_progress 0.2

APK_DIR=$SE_MNT/priv-app/Updater
APK=$APK_DIR/Updater.apk
OTACERTS=$SYS_MNT/system/etc/security/otacerts.zip
[ -f "$APK" ] || abort "The installed Updater was not found at /system_ext/priv-app/Updater."
[ -f "$OTACERTS" ] || abort "/system/etc/security/otacerts.zip was not found."

BUILD_PROP=$SYS_MNT/system/build.prop
grep -qE '^ro\.(lunaris|lineage)\.device=peridot$' "$BUILD_PROP" 2>/dev/null || \
  abort "The installed system is not built for peridot."
# ro.lunaris.device only exists from 2026-08-30; the installed Updater following the Lunaris
# peridot OTA feed identifies every build with OTA support (from 2026-08-05)
unzip -p "$APK" resources.arsc 2>/dev/null | grep -q "$OTA_FEED" || \
  abort "The installed system is not Lunaris for peridot."
BUILD_DATE=$(grep '^ro.build.date=' "$BUILD_PROP" | cut -d= -f2-)
BUILD_UTC=$(grep '^ro.build.date.utc=' "$BUILD_PROP" | cut -d= -f2)
ui_print "- Installed build: $BUILD_DATE"
case "$BUILD_UTC" in
  ''|*[!0-9]*) abort "Could not read the build date of the installed system." ;;
esac
[ "$BUILD_UTC" -lt "$FIX_BUILD_UTC" ] || \
  abort "This build already includes Updater $VERSION_NAME or newer."

# The Updater is only granted its platform SELinux domain (and access to update_engine) when
# it is signed with the same platform key as the build
MAC_PERMISSIONS=$SYS_MNT/system/etc/selinux/plat_mac_permissions.xml
if grep -qF "$TESTKEY_PLATFORM_HEX" "$MAC_PERMISSIONS" 2>/dev/null; then
  ui_print "- Signed with: AOSP test keys"
  TEST_KEYS=1
  NEW_APK=$TMP/payload/Updater-testkey.apk
  APK_SHA256=$APK_TESTKEY_SHA256
elif grep -qF "$RELEASE_PLATFORM_HEX" "$MAC_PERMISSIONS" 2>/dev/null; then
  ui_print "- Signed with: Lunaris release keys"
  TEST_KEYS=0
  NEW_APK=$TMP/payload/Updater-release.apk
  APK_SHA256=$APK_RELEASE_SHA256
else
  abort "This build is signed with keys this zip doesn't know."
fi

UPDATE_APK=1
[ "$(sha256 "$APK")" = "$APK_SHA256" ] && UPDATE_APK=0

# Builds signed with the release keys already trust the release key for OTAs
UPDATE_OTACERTS=0
if [ $TEST_KEYS -eq 1 ] && [ "$(sha256 "$OTACERTS")" != "$OTACERTS_SHA256" ]; then
  if [ "$(unzip -l "$OTACERTS" 2>/dev/null | grep -c 'x509\.pem')" = "1" ] && \
     [ "$(unzip -p "$OTACERTS" testkey.x509.pem 2>/dev/null | sha256sum | cut -d' ' -f1)" = "$TESTKEY_PEM_SHA256" ]; then
    UPDATE_OTACERTS=1
  else
    ui_print "! otacerts.zip has unexpected contents and was left unchanged."
    ui_print "! OTAs signed with the new release key will still be rejected."
  fi
fi

if [ $UPDATE_APK -eq 0 ] && [ $UPDATE_OTACERTS -eq 0 ]; then
  ui_print "- Already up to date."
  cleanup
  exit 0
fi

if [ $UPDATE_APK -eq 1 ] && ! has_room "$NEW_APK" "$APK" "$SE_MNT"; then
  abort "Not enough free space on system_ext."
fi
if [ $UPDATE_OTACERTS -eq 1 ] && ! has_room "$NEW_OTACERTS" "$OTACERTS" "$SYS_MNT"; then
  abort "Not enough free space on system."
fi

cp -p "$APK" "$BACKUP/Updater.apk" || abort "Could not back up Updater.apk."
cp -p "$OTACERTS" "$BACKUP/otacerts.zip" || abort "Could not back up otacerts.zip."
APK_ORIG_SHA256=$(sha256 "$BACKUP/Updater.apk")
OTACERTS_ORIG_SHA256=$(sha256 "$BACKUP/otacerts.zip")
APK_LABEL=$(selinux_label "$APK")
OTACERTS_LABEL=$(selinux_label "$OTACERTS")
set_progress 0.3

# Checks passed; from here on every write is undone if it fails
if [ $UPDATE_APK -eq 1 ]; then
  remount_rw "$SE_DEV" "$SE_MNT" || abort "Could not mount system_ext$SLOT read-write."
  lift_reserve "$SE_DEV" || abort "Could not lift the ext4 space reserve on system_ext$SLOT."
  ui_print "- Installing Updater $VERSION_NAME"
  # The odex/vdex were compiled for the old APK
  rm -rf "$APK_DIR/oat"
  WRITTEN="apk $WRITTEN"
  write_in_place "$NEW_APK" "$APK" "$APK_SHA256" || rollback "Writing Updater.apk failed."
  [ "$(selinux_label "$APK")" = "$APK_LABEL" ] || rollback "Updater.apk lost its SELinux label."
  touch -t $PACKAGE_MTIME "$APK" "$APK_DIR" || \
    ui_print "! Could not set the Updater's timestamp; Android may show the old one until the next update."
fi
set_progress 0.6

if [ $UPDATE_OTACERTS -eq 1 ]; then
  remount_rw "$SYS_DEV" "$SYS_MNT" || rollback "Could not mount system$SLOT read-write."
  lift_reserve "$SYS_DEV" || rollback "Could not lift the ext4 space reserve on system$SLOT."
  ui_print "- Trusting the new Lunaris release key for OTAs"
  WRITTEN="otacerts $WRITTEN"
  write_in_place "$NEW_OTACERTS" "$OTACERTS" "$OTACERTS_SHA256" || rollback "Writing otacerts.zip failed."
  [ "$(selinux_label "$OTACERTS")" = "$OTACERTS_LABEL" ] || rollback "otacerts.zip lost its SELinux label."
fi
set_progress 0.9

cleanup
blockdev --setro "$SE_DEV" 2>/dev/null
blockdev --setro "$SYS_DEV" 2>/dev/null
set_progress 1.0

ui_print " "
ui_print "- Done. Reboot to system."
ui_print "  If you installed the earlier 3.12.1 hotfix as a"
ui_print "  Magisk/KernelSU module, remove that module, or it"
ui_print "  will keep replacing this Updater."
exit 0

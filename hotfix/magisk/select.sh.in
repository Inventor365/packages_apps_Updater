# Chooses what the Lunaris Updater module overlays on the running build. Sourced by
# customize.sh and post-fs-data.sh; generated by make-hotfix-zip.sh, which fills in @...@.

VERSION_NAME="@VERSION_NAME@"
APK_TESTKEY_SHA256="@APK_TESTKEY_SHA256@"
APK_RELEASE_SHA256="@APK_RELEASE_SHA256@"
OTACERTS_SHA256="@OTACERTS_SHA256@"
# testkey.x509.pem, the only certificate the old builds trust for OTAs
TESTKEY_PEM_SHA256="@TESTKEY_PEM_SHA256@"
# DER of the platform certificates, as they appear in plat_mac_permissions.xml
TESTKEY_PLATFORM_HEX="@TESTKEY_PLATFORM_HEX@"
RELEASE_PLATFORM_HEX="@RELEASE_PLATFORM_HEX@"
# Builds from this time on already ship this Updater (or a newer one)
FIX_BUILD_UTC=@FIX_BUILD_UTC@

# Only set by the host-side test harness, to run against a copy of the partitions
R=${LUNARIS_HOTFIX_TEST_ROOT:-}

file_sha256() {
  sha256sum "$1" 2>/dev/null | cut -d' ' -f1
}

payload_intact() {
  [ "$(file_sha256 "$1/payload/Updater-testkey.apk")" = "$APK_TESTKEY_SHA256" ] &&
    [ "$(file_sha256 "$1/payload/Updater-release.apk")" = "$APK_RELEASE_SHA256" ] &&
    [ "$(file_sha256 "$1/payload/otacerts.zip")" = "$OTACERTS_SHA256" ]
}

# Whether otacerts.zip trusts only the AOSP test key, or is already this module's copy
otacerts_needs_release_key() {
  [ "$(file_sha256 "$1")" = "$OTACERTS_SHA256" ] && return 0
  [ "$(unzip -l "$1" 2>/dev/null | grep -c 'x509\.pem')" = "1" ] &&
    [ "$(unzip -p "$1" testkey.x509.pem 2>/dev/null | sha256sum | cut -d' ' -f1)" = "$TESTKEY_PEM_SHA256" ]
}

# Lays out $1/system for the running build from $1/payload. Returns 1, with SELECT_ERROR set,
# if the module doesn't apply to this build. Sets SELECTED_KEYS and ADDED_RELEASE_KEY.
select_files() {
  local moddir=$1 mac="$R/system/etc/selinux/plat_mac_permissions.xml" build_utc apk
  local apk_dir="$1/system/system_ext/priv-app/Updater"
  [ -d "$moddir/payload" ] || { SELECT_ERROR="Module files are missing"; return 1; }
  rm -rf "$moddir/system"
  ADDED_RELEASE_KEY=0

  build_utc=$(getprop ro.build.date.utc)
  case "$build_utc" in
    ''|*[!0-9]*) SELECT_ERROR="Could not read the build date"; return 1 ;;
  esac
  if [ "$build_utc" -ge "$FIX_BUILD_UTC" ]; then
    SELECT_ERROR="This build already includes Updater $VERSION_NAME or newer"
    return 1
  fi

  # The Updater only gets its platform SELinux domain (and access to update_engine) when it
  # is signed with the same platform key as the build
  if grep -qF "$TESTKEY_PLATFORM_HEX" "$mac" 2>/dev/null; then
    SELECTED_KEYS="AOSP test keys"
    apk=Updater-testkey.apk
  elif grep -qF "$RELEASE_PLATFORM_HEX" "$mac" 2>/dev/null; then
    SELECTED_KEYS="Lunaris release keys"
    apk=Updater-release.apk
  else
    SELECT_ERROR="This build is signed with keys this module doesn't know"
    return 1
  fi

  mkdir -p "$apk_dir" && cp "$moddir/payload/$apk" "$apk_dir/Updater.apk" || {
    SELECT_ERROR="Could not set up the module files"
    return 1
  }
  # Replace the whole directory, so the odex/vdex compiled for the old APK are hidden too
  touch "$apk_dir/.replace"

  if [ "$apk" = Updater-testkey.apk ] &&
      otacerts_needs_release_key "$R/system/etc/security/otacerts.zip"; then
    mkdir -p "$moddir/system/etc/security" &&
      cp "$moddir/payload/otacerts.zip" "$moddir/system/etc/security/otacerts.zip" &&
      ADDED_RELEASE_KEY=1
  fi

  chown -R 0:0 "$moddir/system" 2>/dev/null
  chmod -R u=rwX,go=rX "$moddir/system"
  chcon -R u:object_r:system_file:s0 "$moddir/system" 2>/dev/null
  return 0
}
